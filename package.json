{
  "name": "bls-kabine-lehrtool",
  "productName": "BLS-Kabine Lehrtool",
  "description": "BLS-Kabine Lehrtool: Bahnplanung und Spritzbildprognose (Demo, nur für Lehrzwecke)",
  "author": "Hendrik Dubbe",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.mjs",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "vitest run --maxWorkers=2 --testTimeout=30000",
    "typecheck": "tsc --noEmit",
    "build": "npm run test && npm run typecheck && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
